# DS-Chat 本地网关配置
# 复制为 .env.local 后填写。.env.local 已被 .gitignore 忽略，不会提交。

# ── DeepSeek 官方 API（负责联网搜索 / 读链接 / 附件 / 语音 / 首轮标题）──
# 申请地址 https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ── OpenCode Go（负责普通对话）──
# 留空时会自动从 DSH 的 ~/.dsh/.credentials.yaml 读取 OPENCODE_GO_API_KEY
OPENCODE_GO_API_KEY=

# OpenCode Go 必需的会话头，缺失会 400 MissingSessionID
OCGO_SESSION=63acfced-83c5-4f27-8be0-edf88cb8679e

# ── 路由 ──
# auto=按能力分流（默认）｜ocgo=全部走 OCGO｜official=全部走官方
DS_ROUTE=auto

# 会话标题策略：first-turn-official=首轮走官方以获得标题｜strip=剥掉 title（标题为空）
DS_TITLE_STRATEGY=first-turn-official

# 混合搜索：选中的 OCGO 遇到搜索轮次时，由网关调用官方搜索接口执行
# 设为 0 则整轮回落到官方 provider
DS_HYBRID_SEARCH=1

# 设为 0 关闭每请求路由日志
DS_VERBOSE=1
